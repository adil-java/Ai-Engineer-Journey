# Copy this file to .env and fill in your own values. Never commit .env.

# GitHub fine-grained token: public repositories, read-only, no other permissions
GITHUB_TOKEN=

# Google AI Studio key (aistudio.google.com). Use a project with NO billing account linked:
# that is the free tier, which is charged $0 (over the limit you get 429 errors, never a bill).
GEMINI_API_KEY=
# Optional: override the classifier model (default gemini-3.5-flash-lite)
GEMINI_MODEL=
# Optional: seconds between Gemini calls to stay under free-tier per-minute limits (default 6)
GEMINI_MIN_INTERVAL=

# Django web app (app/). Local dev works with these empty (DEBUG on, dev-only key).
# Anywhere else: DJANGO_DEBUG=0 and a long random DJANGO_SECRET_KEY.
DJANGO_DEBUG=
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
